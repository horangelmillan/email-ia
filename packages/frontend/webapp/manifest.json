{
  "_version": "1.58.0",
  "sap.app": {
    "id": "com.emailia.frontend",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "0.0.0" },
    "i18n": "i18n/i18n.properties"
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.133.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.f": {},
        "sap.ui.layout": {}
      }
    },
    "rootView": {
      "viewName": "com.emailia.frontend.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.emailia.frontend.i18n.i18n",
          "supportedLocales": ["", "en", "es"],
          "fallbackLocale": "en"
        }
      },
      "app": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": {
          "appTitle": "Email IA",
          "appVersion": "0.0.0"
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "path": "com.emailia.frontend.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "transition": "slide",
        "async": true
      },
      "routes": [
        { "name": "home", "pattern": "", "target": "home" },
        { "name": "inbox", "pattern": "inbox", "target": "inbox" }
      ],
      "targets": {
        "home": { "viewId": "home", "viewName": "Home", "viewLevel": 1 },
        "inbox": { "viewId": "inbox", "viewName": "Inbox", "viewLevel": 2 }
      }
    },
    "contentDensities": { "compact": true, "cozy": true }
  }
}
