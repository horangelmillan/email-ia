    "@email-ia/core": "workspace:*",
    "@email-ia/shared": "workspace:*"
  },
  "devDependencies": {
    "@email-ia/tsconfig": "workspace:*",
    "electron": "^37.10.3",
    "typescript": "^5.0.0",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
