{
  "name": "@email-ia/electron",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "vite",
    "build:vite": "vite build",
    "start": "electron .",
    "smoke": "electron . --smoke",
    "package": "npx --yes electron-builder"
