{
  "name": "classify-email",
  "version": "1.0.0",
  "description": "Clasifica un email en categorías",
  "metadata": {
    "tags": ["classify"],
    "author": "email-ia"
  },
  "variables": [
    { "name": "subject", "type": "string", "required": true },
    { "name": "body", "type": "string", "required": true },
    { "name": "priority", "type": "number", "required": false }
  ],
  "messages": [
    { "role": "system", "content": "Clasifica el email en: trabajo, personal, spam." },
    { "role": "user", "content": "Asunto: {{subject}}\nCuerpo: {{body}}\nPrioridad: {{priority}}" }
  ]
}
